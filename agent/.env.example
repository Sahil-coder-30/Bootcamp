# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# --- API keys (get these during PREWORK) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Model ids (override if you like) ---
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Second NVIDIA model — the "nvidia-alt" provider. Same key, different model.
NVIDIA_MODEL_2=nvidia/nemotron-3.5-lightning-30b-a3b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Research fan-out ---
# Which providers the research step queries, in order. The default uses all three
# vendors. If your Gemini quota is dead, drop it and use a 2nd NVIDIA model:
#   RESEARCH_PROVIDERS=nvidia,groq,nvidia-alt
RESEARCH_PROVIDERS=nvidia,groq,gemini

# --- Generation settings ---
LLM_TEMPERATURE=0.2

# Role 1 JD extraction (/extract/jd): provider order for the structured LLM pass.
# Falls back to RESEARCH_PROVIDERS when unset. Gemini flash-lite is the fastest (~7 s per JD).
EXTRACT_PROVIDERS=gemini,groq,nvidia
# Per-provider timeout for one extraction call, in seconds.
EXTRACT_TIMEOUT_S=90
