# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# --- API keys (get these during PREWORK) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Model ids (override if you like) ---
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Second NVIDIA model — the "nvidia-alt" provider. Same key, different model.
NVIDIA_MODEL_2=nvidia/llama-3.1-nemotron-70b-instruct
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Research fan-out ---
# Which providers the research step queries, in order. The default uses all three
# vendors. If your Gemini quota is dead, drop it and use a 2nd NVIDIA model:
#   RESEARCH_PROVIDERS=nvidia,groq,nvidia-alt
RESEARCH_PROVIDERS=nvidia,nvidia-alt,gemini

# --- Generation settings ---
LLM_TEMPERATURE=0.2
