# Backend base URL. Leave empty in local dev: Vite proxies /api to http://localhost:4000.
# Set it in production, e.g. https://placeintel-backend.onrender.com
VITE_API_URL=
# Optional: logo.dev publishable key for company logos (public by design).
VITE_LOGO_DEV_PUBLISHABLE_KEY=
# Optional: Google OAuth web client id (public). Leave empty to fetch it from the auth service (/api/auth/config).
VITE_GOOGLE_CLIENT_ID=
# true = Talent Check also requires sign-in (profile page always does).
VITE_AUTH_REQUIRED=
