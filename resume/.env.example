# Resume service settings. Copy to resume/.env for local runs. No LLM keys: parsing is offline.
RESUME_PORT=8100
# Postgres (Supabase / k8s). Leave unset to use a local SQLite file in resume/data/.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# Original files go to S3 when a bucket is set; otherwise to resume/data/files/.
# S3_BUCKET=my-resume-bucket
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO / LocalStack only
# RESUME_S3_PREFIX=resume-files
# Optional shared secret; the backend then sends it as X-Resume-Key.
# RESUME_API_KEY=
RESUME_MAX_UPLOAD_MB=5
# RESUME_SPACY_MODEL=en_core_web_sm   # "off" runs on heuristics only
