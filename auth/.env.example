# Auth service. Copy to .env for local dev. Never commit real values.
PORT=4100
CORS_ORIGINS=http://localhost:5173

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" in the Google OAuth client, character for character.
# Dev (through the Vite proxy): http://localhost:5173/api/auth/google/callback
# Skaffold/ingress:             http://localhost/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# Where the browser lands after sign-in (the frontend origin)
FRONTEND_URL=http://localhost:5173

# At least 32 random chars: openssl rand -base64 48. The backend must use the SAME value to verify tokens.
JWT_SECRET=
JWT_ISSUER=placeintel-auth
JWT_AUDIENCE=placeintel
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Postgres (Supabase connection string). Empty = in-memory store for local dev only.
DATABASE_URL=
# true = apply auth/migrations/*.sql at boot (idempotent)
AUTO_MIGRATE=false

# Optional: restrict sign-in to these email domains, e.g. jssaten.ac.in
ALLOWED_EMAIL_DOMAINS=
# Optional: these emails get role=admin
ADMIN_EMAILS=
