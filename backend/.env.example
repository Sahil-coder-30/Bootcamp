PORT=4000
# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Supabase (server-side only, never expose to the frontend).
# Without these the API serves the bundled seed data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY= (alternative to the service-role key for read-only access)

# FastAPI agent service (../agent)
AGENT_URL=http://localhost:8000
# Resume parsing service (../resume)
RESUME_URL=http://localhost:8100
# RESUME_API_KEY=   # only if the resume service sets one

# Role 1 JD Analytics store: "supabase" (needs SUPABASE_SERVICE_ROLE_KEY and the
# 20261028_02_role1_jd_analytics.sql migration) or "file" (local JSON, for demos).
# Default: supabase when the service-role key is set, else file.
# JD_STORE=file
# JD_STORE_DIR=.data/jd-store

# Only for scripts/populate-live-supabase.py (direct Postgres access).
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
